{
  "name": "@gdn/semantic-release-native",
  "version": "1.3.2",
  "description": "plugin for semantic release that automatically updates the android and ios versions",
  "scripts": {
    "test-watch": "npx jest --watch",
    "coverage": "npx jest --coverage --runInBand",
    "test": "npx jest --runInBand",
    "lint": "eslint -c eslint.config.mjs",
    "lint-fix": "npm run lint -- --fix",
    "copy": "npx copyfiles -u 2 __tests__/**/build.gradle __tests__/**/info.plist dist/",
    "build": "npx rimraf dist && npx tsc",
    "semantic-release": "semantic-release",
    "setup-node-version": "npx setupNodeVersion --version=26",
    "tsc": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidion-digital/semantic-release-native.git"
  },
  "private": false,
  "main": "dist/index",
  "types": "./dist/index.d.ts",
  "author": "Guidion",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/guidion-digital/semantic-release-native/issues"
  },
  "homepage": "https://github.com/guidion-digital/semantic-release-native#readme",
  "devDependencies": {
    "@gdn/eslint-config-core": "^1.4.0",
    "@gdn/js-backend-toolkit": "^3.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/semver": "^7.8.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "rimraf": "^6.1.2",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@semantic-release/error": "^3.0.0",
    "plist": "^3.0.6",
    "semver": "^7.8.5"
  },
  "release": {
    "branches": [
      "prod"
    ]
  }
}
